# Variables de entorno para el FRONTEND
# Solo puedes poner aquí valores NO SECRETOS.
# Todo lo que tenga VITE_ puede terminar dentro del JavaScript del navegador.

# ✅ Seguro: URL de la API
VITE_API_URL=https://api.gesicomm.com

# ✅ Seguro: IDs públicos (no son secretos)
# VITE_META_PIXEL_ID=123456789

# ❌ NUNCA pongas esto aquí:
# VITE_JWT_SECRET=...
# VITE_DATABASE_PASSWORD=...
# VITE_SHOPIFY_SECRET=...
# VITE_META_ACCESS_TOKEN=...
